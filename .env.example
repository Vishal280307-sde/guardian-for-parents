# =============================================================================
# Guardian for Parents — Environment Configuration
# =============================================================================

# --- 1. AI Intelligence (Google Gemini) ---
# Required for server-side OCR, scam explanations, and conversational assistant.
# NEVER expose Gemini key via VITE_* variables.
GEMINI_API_KEY="your-gemini-api-key"

# --- 2. Production Service URL & Port ---
# On Render: PORT is automatically injected (default 10000).
# APP_URL or RENDER_EXTERNAL_URL: Public HTTPS URL for the deployed web service.
APP_URL="https://your-guardian-app.onrender.com"
PORT=3000
NODE_ENV="production"
NODE_VERSION="22.14.0"

# --- 3. Persistent Database Configuration (Turso / libSQL) ---
# Required for production deployment on Render (or Vercel).
# Use your existing Turso database URL and Auth Token.
# Supported protocols: libsql:// or https://
TURSO_DATABASE_URL="libsql://your-db-name-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Local SQLite fallback (only used in local dev or containers with attached disk)
GUARDIAN_DB_PATH="./data/guardian.db"

# --- 4. Security & Demo Seeding Guard ---
# NEVER enable demo accounts in production (set strictly to "false").
ENABLE_DEMO_ACCOUNTS="false"

# --- 5. CORS Origins ---
# Comma-separated list of additional allowed origins for CORS.
# Render external hostname is automatically permitted.
CORS_ORIGINS="http://localhost:3000,https://localhost,capacitor://localhost"

# --- 6. Frontend Build Settings ---
# Leave empty ("") for same-origin web hosting (Render single Web Service).
# Set to full HTTPS backend URL only when building a standalone Android APK.
VITE_API_BASE_URL=""
VITE_APP_ENV="production"
